      "css": ".ds-detail{border-top:1px solid var(--rule,#d4dfd8);color:var(--ink,#102f29);font-family:var(--font-body,\"Manrope\",sans-serif);}.ds-detail summary{cursor:pointer;font-size:14px;font-weight:600;padding-block:18px}.ds-detail summary:hover{color:var(--green,#155a43)}.ds-detail summary:focus-visible{outline:3px solid var(--green,#155a43);outline-offset:5px;}.ds-detail p{margin:0;padding-bottom:22px;max-width:75ch;font-size:14px;line-height:1.65;color:var(--muted,#4c625b)}"
    }
