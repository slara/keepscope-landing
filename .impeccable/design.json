  "narrative": {
    "northStar": "Visible protection",
    "overview": "An approachable enterprise security system: pale mint, deep pine ink, generous spacing, and compact white demonstrations make sensitive-data handling legible. The user-selected category direction favors familiar navigation, plain Spanish, and concrete product states.\n\nSelf-hosted Manrope carries every role. Rounded demonstration surfaces, fine separators, and restrained motion provide clarity without ornamental imagery. The existing favicon remains the identity asset; the build adds no raster imagery.",
    "keyCharacteristics": [
      "Mint and pine with explicit semantic state colors.",
      "One type family, strong heading hierarchy, compact labels.",
      "Spacious sections around useful, operable demonstrations."
    ],
    "rules": [
      {
        "name": "The Readable States Rule",
        "body": "Pair state color with words: pending, approved, and protected data remain understandable without color.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Use self-hosted Manrope for headings, prose, navigation, and product examples.",
        "section": "typography"
      },
      {
        "name": "The Demonstration Depth Rule",
        "body": "Reserve the ambient shadow for the primary interactive demonstration; use surface tones and separators elsewhere.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the mint brand accent, existing favicon, and Spanish interface.",
      "Do use white product surfaces, sentence-case labels, and visible text for every state.",
      "Do let columns stack and text wrap; retain the demonstration content on narrow screens.",
      "Do honor reduced motion and retain visible keyboard focus."
    ],
    "donts": [
      "Don't use status color as the only explanation of a result.",
      "Don't promote illustrative examples into customer evidence or performance claims.",
      "Don't replace the approved category direction with sparse abstract layouts."
    ]
  }
}
